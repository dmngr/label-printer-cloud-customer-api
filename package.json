{
  "name": "label-printer-cloud-customer-api",
  "version": "1.0.2",
  "description": "Customer-facing read-only API Lambda for the DM Label Printer customer-facing web app at app.label.ninja - exposes /api/v1/me/stores, /api/v1/me/devices and /api/v1/me/devices/{deviceCode} over a single Function URL.",
  "main": "dist/handlers/customer-api.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint:check": "type_check_lambdas_v3 lint:check",
    "lint:fix": "type_check_lambdas_v3 lint:fix",
    "format:check": "type_check_lambdas_v3 format:check",
    "format:fix": "type_check_lambdas_v3 format:fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/smoke.test.js",
    "deploy:prod": "npm run rebuild && lambda-upload deploy-prod dm",
    "deploy:prod:check": "lambda-upload deploy-prod dm --check --force --assume-runtime nodejs24.x",
    "deploy:prod:upgrade": "npm run rebuild && lambda-upload deploy-prod dm --upgrade-config",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "rebuild": "npm run clean && npm run build",
    "prepackage": "npm run rebuild"
  },

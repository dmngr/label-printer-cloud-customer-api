{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPrintImageJob",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudPrintJobs"
    },
    {
      "Sid": "ListPrivateDevImages",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::dm-label-printer-images-dev-787324535455-eu-west-1",
      "Condition": { "StringLike": { "s3:prefix": "label-images/v1/*" }, "NumericLessThanEquals": { "s3:max-keys": "20" } }
    },
    {
      "Sid": "ReadPrivateDevImages",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::dm-label-printer-images-dev-787324535455-eu-west-1/label-images/v1/*"
    },
    {
      "Sid": "FenceDeviceDeliveryMode",
      "Effect": "Allow",
      "Action": "dynamodb:ConditionCheckItem",
      "Resource": "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudDevices",
      "Condition": { "ForAnyValue:StringEquals": { "dynamodb:EnclosingOperation": ["TransactWriteItems"] } }
    },
    {
      "Sid": "CreateDeliveryInbox",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudDeliveryInbox"
    },
    {
      "Sid": "GroupTemplateLibrary",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudTemplateLibrary"
    },
    {
      "Sid": "ConditionGroupTemplateState",
      "Effect": "Allow",
      "Action": "dynamodb:ConditionCheckItem",
      "Resource": "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudTemplateLibrary",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "dynamodb:EnclosingOperation": ["TransactWriteItems"]
        }
      }
    },
    {
      "Sid": "CreateOwnLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:eu-west-1:787324535455:*"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:eu-west-1:787324535455:log-group:/aws/lambda/label-printer-cloud-customer-api:*"
    },
    {
      "Sid": "ReadAndTouchCustomerTokens",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudCustomerTokens"
    },
    {
      "Sid": "ReadDevices",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudDevices"
    },
    {
      "Sid": "QueryCatalog",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": [
        "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudCatalogProducts",
        "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudCatalogProducts/index/DeviceCodeIndex",
        "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudCatalogTemplates",
        "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudCatalogTemplates/index/DeviceCodeIndex"
      ]
    },
    {
      "Sid": "QueryPrintJobs",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": [
        "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudPrintJobs",
        "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudPrintJobs/index/DeviceCreatedIndex"
      ]
    },
    {
      "Sid": "AllocateCommandIds",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudCounters"
    },
    {
      "Sid": "SharedPrintAcceptanceReceipts",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudCounters",
      "Condition": { "ForAllValues:StringLike": { "dynamodb:LeadingKeys": ["PrintRequestV1:*"] } }
    },
    {
      "Sid": "CreateAndReadCommands",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:eu-west-1:787324535455:table/DMLabelPrinterCloudDeviceCommands"
    }
  ]
}
